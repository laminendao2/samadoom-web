{
  "expo": {
    "name": "Sama Doom",
    "slug": "sama-doom",
    "version": "2.4.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mycompany.daara",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "Sama Doom utilise votre identifiant publicitaire pour mesurer les performances de l'application et vous proposer des contenus adaptés. Aucune donnée n'est vendue à des tiers.",
        "NSPhotoLibraryUsageDescription": "Sama Doom accède à vos photos pour vous permettre de télécharger votre photo de profil ou le logo de votre établissement.",
        "NSCameraUsageDescription": "Sama Doom accède à votre caméra pour les cours vidéo en direct avec votre professeur, et pour prendre une photo de profil.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.471912967633-vlpifmsh17t5hofl2vgsom22l156176h"
            ]
          }
        ],
        "NSLocationWhenInUseUsageDescription": "Sama Doom utilise votre position pour calculer les horaires de prières selon votre lieu de résidence.",
        "NSMicrophoneUsageDescription": "Sama Doom accède à votre microphone pour les cours vidéo en direct avec votre professeur."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.mycompany.daara",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.mycompany.daara"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.googleusercontent.apps.471912967633-tmbrtoh0mjlakqm7kubsh5r9gftngngb"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "com.google.android.gms.permission.AD_ID",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.READ_PHONE_STATE"
      ]
    },
    "plugins": [
      "./plugins/withIosDeploymentTarget",
      "./plugins/withIosSceneLifecycle",
      "expo-apple-authentication",
      "expo-tracking-transparency",
      "expo-speech-recognition",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sama Doom utilise votre position pour calculer les horaires de prières."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1B5E20",
          "defaultChannel": "prieres",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "useLegacyPackaging": false,
            "ndkVersion": "28.0.12433566",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "da8a8267-9919-4c3f-80d8-f5fd9c1dfb89"
      }
    },
    "owner": "laminendao2",
    "runtimeVersion": "2",
    "updates": {
      "url": "https://u.expo.dev/da8a8267-9919-4c3f-80d8-f5fd9c1dfb89",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}